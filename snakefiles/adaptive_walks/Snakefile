rule build_random_fitness_landscape:
    input:
        "phenotype_ranking.txt"
    output:
        "fl.txt"
    params:
        min_f=config["random_fitness_landscape_params"]["min_f"],
        max_f=config["random_fitness_landscape_params"]["max_f"],
        lethal_ph=config["unviable"],
    shell:
        "random_fitness_landscape.py "
        "--phenotypes {input} "
        "--low_f {params.min_f} "
        "--upp_f {params.max_f} "
        "--lethal_ph {params.lethal_ph} "
        "-o {output} "

rule run_adaptive_walks_productive_trace_paths_update_T_sample_ph:
    input:
        fl="fl.txt",
        gp_map="gp_map.pickle",
        phenotype_sample="phenotypes_sample.txt"
    output:
        walk_lengths="walk_lengths_seed{seed}.csv",
        paths="paths_seed{seed}.csv"
    params:        
        max_steps=None,  # int
        sample_size_walks=None,  # int
        avoid_phenotype=None,  # immutable
    shell:
        "adaptive_walks_productive_trace_path_update_T_sample_ph.py "
        "-i {input.gp_map} "
        "-f {input.fl} "
        "--phenotype_sample {input.phenotype_sample} "
        "-l {output.walk_lengths} "
        "-p {output.paths} "
        "-n {wildcards.pop_size} "
        "-m {params.max_steps} "
        "-a {params.avoid_phenotype} "
        "-s {params.sample_size_walks} "
        "-r {wildcards.seed} "


rule compute_navigability_per_ph_per_fl:
    input:
        walk_length_files="walk_length_files"
    output:
        "navigability_per_ph_per_fl.txt"
    params:
        sample_size=1
    shell:
        "compute_navigability_per_ph_per_fl.py "
        "-w {input.walk_length_files} "  # assumes one per fitness landscape
        "-s {params.sample_size} "
        "-o {output} "

rule compute_uphill_navigability_per_ph_per_fl:
    input:
        paths=["adaptive_path_files"],
        gp_map_pickle="gp_map.pickle",
        fitness_landscapes=["fl_landscape_files"]
    output:
        "navigability_per_ph_per_fl.txt"
    params:
        sample_size=1
    shell:
        "compute_uphill_navigability_per_ph_per_fl.py "
        "-p {input.paths} "  # assumes one per fitness landscape
        "-f {input.fitness_landscapes} "
        "-g {input.gp_map_pickle} "
        "-s {params.sample_size} "
        "-o {output} "

rule compute_ruggedness_whole_map:
    input:
        nc_graph="nc_graph.pickle",
    output:
        "peak_sizes.txt"
    params:
        min_f=config["random_fitness_landscape_params"]["min_f"],
        max_f=config["random_fitness_landscape_params"]["max_f"],
        lethal_ph=config["unviable"],
        sample_size=1
    shell:
        "compute_ruggedness_whole_map.py "
        "--nc_graph {input.nc_graph} "
        "--low_f {params.min_f} "
        "--upp_f {params.max_f} "
        "--lethal_ph {params.lethal_ph} "
        "--sample_size {params.sample_size} "
        "-o {output} "


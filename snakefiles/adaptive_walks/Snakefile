        "-o {output} "

rule categorize_paths:
    input:
        paths=["paths.txt"],
        fls=["fitness_landscapes.txt"],
        nc_graph_pickle="nc_graph.pickle",
        gp_map_pickle="gp_map.pickle"
    output:
        "path_categories.pickle"
    shell:
        "categorize_evo_paths.py "
        "-p {input.paths} "
        "-f {input.fls} "
        "-n {input.nc_graph_pickle} "
        "-g {input.gp_map_pickle} "
        "-o {output} "
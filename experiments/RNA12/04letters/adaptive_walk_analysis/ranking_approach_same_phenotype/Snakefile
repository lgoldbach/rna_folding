configfile: "./config.yaml"

rule all:
    input:
        expand("gp_map_{gp_map_id}/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/analysis/adaptive_walks_neutral_comp_seed{seed}.pdf", 
                fl_id=range(1, config["random_fitness_landscape_params"]["N"]+1), 
                pop_size=config["adaptive_walks"]["population_sizes"],
                seed=config["random_seeds"],
                gp_map_id=config["gp_maps"].keys()),
        expand("gp_map_{gp_map_id}/analysis/navigability_over_ruggedness_pop{pop_size}_seed{seed}.pdf", gp_map_id=config["gp_maps"].keys(), pop_size=config["adaptive_walks"]["population_sizes"],
                seed=config["random_seeds"],)

rule get_neutral_component_sizes:
    output:
        "gp_map_{gp_map_id}/neutral_component_sizes.txt"
    params:
        ignore=config["mapping_params"]["unfolded"],
        gp_map=lambda wildcards: config["gp_maps"][wildcards.gp_map_id]
    shell:
        "neutral_components.py "
        "-f {params.gp_map} "
        "-i {params.ignore} "
        "-o {output} "

rule build_nc_graph:
    output:
        graph="gp_map_{gp_map_id}/nc_graph.pickle",
        nc_to_genotype="gp_map_{gp_map_id}/nc_to_genotype.txt"
    params:
        ignore=config["mapping_params"]["unfolded"],
        gp_map=lambda wildcards: config["gp_maps"][wildcards.gp_map_id]
    shell:
        "nc_graph.py "
        "-f {params.gp_map} "
        "-i {params.ignore} "
        "-g {output.graph} "
        "-m {output.nc_to_genotype} "

rule build_random_fitness_landscapes:
    input:
        "phenotypes.txt"
    output:
        "gp_map_{gp_map_id}/fl_{fl_id}/fl.txt"
    params:
        min_f=config["random_fitness_landscape_params"]["min_f"],
        max_f=config["random_fitness_landscape_params"]["max_f"],
        lethal_ph=config["random_fitness_landscape_params"]["lethal"],
        peak=lambda wildcards: config["target_phenotypes"][wildcards.gp_map_id]
    shell:
        "random_fitness_landscape.py "
        "--phenotypes {input} "
        "--low_f {params.min_f} "
        "--upp_f {params.max_f} "
        "--lethal_ph {params.lethal_ph} "
        "--global_peak '{params.peak}' "
        "-o {output} "

rule run_adaptive_walks_productive_trace_paths:
    input:
        fl="gp_map_{gp_map_id}/fl_{fl_id}/fl.txt",
    output:
        walk_lengths="gp_map_{gp_map_id}/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/walk_lengths_seed{seed}.csv",
        paths="gp_map_{gp_map_id}/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/paths_seed{seed}.csv"
    params:
        gp_map=lambda wildcards: config["gp_maps"][wildcards.gp_map_id],
        max_steps=config["adaptive_walks"]["max_steps"],
        sample_size_walks=config["adaptive_walks"]["sample_size_walks"],
        avoid_phenotype=config["random_fitness_landscape_params"]["lethal"]
    shell:
        "adaptive_walks_productive_trace_path.py "
        "-i {params.gp_map} "
        "-f {input.fl} "
        "-l {output.walk_lengths} "
        "-p {output.paths} "
        "-n {wildcards.pop_size} "
        "-m {params.max_steps} "
        "-a {params.avoid_phenotype} "
        "-s {params.sample_size_walks} "
        "-r {wildcards.seed} "

rule plot_adaptive_walk_over_neutral_components:
    input:
        paths="gp_map_{gp_map_id}/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/paths_seed{seed}.csv",
        nc="gp_map_{gp_map_id}/nc_graph.pickle",
        nc_to_gt="gp_map_{gp_map_id}/nc_to_genotype.txt",
        fl="gp_map_{gp_map_id}/fl_{fl_id}/fl.txt"
    output:
        "gp_map_{gp_map_id}/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/analysis/adaptive_walks_neutral_comp_seed{seed}.pdf"
    shell:
        "plot_adaptive_walks_over_neutral_components.py "
        "-p {input.paths} "
        "-n {input.nc} "
        "-m {input.nc_to_gt} "
        "-f {input.fl} "
        "-o {output} "

rule plot_navigability_over_ruggedness:
    input:
        walk_lengths=expand("gp_map_{{gp_map_id}}/fl_{fl_id}/adaptive_walks/pop_size{{pop_size}}/walk_lengths_seed{{seed}}.csv", fl_id=range(1, config["random_fitness_landscape_params"]["N"] + 1)),
        nc="gp_map_{gp_map_id}/nc_graph.pickle",
        fl=expand("gp_map_{{gp_map_id}}/fl_{fl_id}/fl.txt", fl_id=range(1, config["random_fitness_landscape_params"]["N"] + 1)),
    output:
        "gp_map_{gp_map_id}/analysis/navigability_over_ruggedness_pop{pop_size}_seed{seed}.pdf"
    params:
        target_ph=lambda wildcards: config["target_phenotypes"][wildcards.gp_map_id]
    shell:
        "plot_adaptive_walk_success_over_ruggedness.py "
        "-l {input.walk_lengths} "
        "-n {input.nc} "
        "-f {input.fl} "
        "-p '{params.target_ph}' "
        "-o {output} "


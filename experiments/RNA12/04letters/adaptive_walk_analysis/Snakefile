configfile: "./config.yaml"

rule all:
    input:
        # "neutral_component_sizes.txt",
        expand("random_fitness_landscapes/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/analysis/adaptive_walks_neutral_comp_seed{seed}.pdf", 
                fl_id=range(1, config["random_fitness_landscape_params"]["N"]+1), 
                pop_size=config["adaptive_walks"]["population_sizes"],
                seed=config["random_seeds"]),

rule generate_genotype_space:
    output:
        "genotypes.txt"
    params:
        alphabet=config["alphabet"],
        seq_len=config["sequence_lengths"]
    shell:
        "build_genotype_space.py " 
        "-a {params.alphabet} "
        "-l {params.seq_len} "
        "-o {output}"

rule vienna_mfe_gp_map:
    input:
        "genotypes.txt"
    output:
        "gp_map.txt"
    shell:
        "viennaRNAmfe_gp_mapping.py "
        "-i {input} "
        "-o {output} "

rule extract_phenotype_list:
    input:
        "gp_map.txt"
    output:
        "phenotypes.txt"
    shell:
        "cat {input} > tmp_phenotypes && " 
        "awk '{{print $1}}' {input} | sort | uniq > {output} && "
        "rm tmp_phenotypes"

rule get_neutral_component_sizes:
    input:
        "gp_map.pickle"
    output:
        "neutral_component_sizes.txt"
    params:
        ignore=config["mapping_params"]["unfolded"]
    shell:
        "neutral_components.py "
        "-f {input} "
        "-i {params.ignore} "
        "-o {output} "

rule build_gpmap_python_object:
    input:
        gp_map="gp_map.txt",
        genotypes="genotypes.txt"
    output:
        "gp_map.pickle",
    params:
        alphabet=config["alphabet"]
    resources:
        mem_mb=60000
    shell:
        "build_gpmap_pickle.py "
        "-f {input.gp_map} "
        "-g {input.genotypes} "
        "-a {params.alphabet} "
        "-o {output}"

rule build_nc_graph:
    input:
        gp_map="gp_map.pickle"
    output:
        graph="nc_graph.pickle",
        nc_to_genotype="nc_to_genotype.txt"
    params:
        ignore=config["mapping_params"]["unfolded"]
    shell:
        "nc_graph.py "
        "-f {input.gp_map} "
        "-i {params.ignore} "
        "-g {output.graph} "
        "-m {output.nc_to_genotype} "

rule build_random_fitness_landscapes:
    input:
        "phenotypes.txt"
    output:
        "random_fitness_landscapes/fl_{fl_id}/fl.txt"
    params:
        min_f=config["random_fitness_landscape_params"]["min_f"],
        max_f=config["random_fitness_landscape_params"]["max_f"],
        lethal_ph=config["random_fitness_landscape_params"]["lethal"]
    shell:
        "random_fitness_landscape.py "
        "--phenotypes {input} "
        "--low_f {params.min_f} " 
        "--upp_f {params.max_f} "
        "--lethal_ph {params.lethal_ph} "
        "-o {output} "

rule run_adaptive_walks_productive_trace_paths:
    input:
        fl="random_fitness_landscapes/fl_{fl_id}/fl.txt",
        gp_map="gp_map.pickle"
    output:
        walk_lengths="random_fitness_landscapes/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/walk_lengths_seed{seed}.csv",
        paths="random_fitness_landscapes/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/paths_seed{seed}.csv"
    params:
        max_steps=config["adaptive_walks"]["max_steps"],
        sample_size_walks=config["adaptive_walks"]["sample_size_walks"],
        avoid_phenotype=config["random_fitness_landscape_params"]["lethal"]
    shell:
        "adaptive_walks_productive_trace_path.py "
        "-i {input.gp_map} "
        "-f {input.fl} "
        "-l {output.walk_lengths} "
        "-p {output.paths} "
        "-n {wildcards.pop_size} "
        "-m {params.max_steps} "
        "-a {params.avoid_phenotype} "
        "-s {params.sample_size_walks} "
        "-r {wildcards.seed} "

rule plot_adaptive_walk_over_neutral_components:
    input:
        paths="random_fitness_landscapes/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/paths_seed{seed}.csv",
        nc="nc_graph.pickle",
        nc_to_gt="nc_to_genotype.txt",
        fl="random_fitness_landscapes/fl_{fl_id}/fl.txt"
    output:
        "random_fitness_landscapes/fl_{fl_id}/adaptive_walks/pop_size{pop_size}/analysis/adaptive_walks_neutral_comp_seed{seed}.pdf"
    shell:
        "plot_adaptive_walks_over_neutral_components.py "
        "-p {input.paths} "
        "-n {input.nc} "
        "-m {input.nc_to_gt} "
        "-f {input.fl} "
        "-o {output} "

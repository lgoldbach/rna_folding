rule run_adaptive_walks_productive:
    input:
        "bp_graph{bp}/ranking{rank}/gp_map.pickle"
    output:
        "bp_graph{bp}/ranking{rank}/productive_walk_lengths_{pop_size}_seed{seed}.csv",
    params:
        max_steps=config["adaptive_walks"]["max_steps"],
        sample_size_walks=config["adaptive_walks"]["sample_size_walks"],
        sample_size_landscapes=config["adaptive_walks"]["sample_size_landscapes"],
        lethal=config["mapping_params"]["unfolded"]
    shell:
        "adaptive_walks_productive.py "
        "-i {input} "
        "-o {output} "
        "-n {wildcards.pop_size} "
        "-m {params.max_steps} "
        "-l {params.sample_size_landscapes} "
        "-s {params.sample_size_walks} "
        "-u {params.lethal} "
        "-r {wildcards.seed} "

rule run_adaptive_walks_productive_vienna:
    input:
        "viennaRNA/gp_map.pickle"
    output:
        "viennaRNA/productive_walk_lengths_{pop_size}_seed{seed}.csv",
    params:
        max_steps=config["adaptive_walks"]["max_steps"],
        sample_size_walks=config["adaptive_walks"]["sample_size_walks"],
        sample_size_landscapes=config["adaptive_walks"]["sample_size_landscapes"],
        lethal=config["mapping_params"]["unfolded"]
    shell:
        "adaptive_walks_productive.py "
        "-i {input} "
        "-o {output} "
        "-n {wildcards.pop_size} "
        "-m {params.max_steps} "
        "-l {params.sample_size_landscapes} "
        "-s {params.sample_size_walks} "
        "-u {params.lethal} "
        "-r {wildcards.seed} "

rule run_adaptive_walks_greedy:
    input:
        "bp_graph{bp}/ranking{rank}/gp_map.pickle"
    output:
        "bp_graph{bp}/ranking{rank}/greedy_walk_lengths_seed{seed}.csv",
    params:
        max_steps=config["adaptive_walks"]["max_steps"],
        sample_size_walks=config["adaptive_walks"]["sample_size_walks"],
        sample_size_landscapes=config["adaptive_walks"]["sample_size_landscapes"],
        lethal=config["mapping_params"]["unfolded"]
    shell:
        "adaptive_walks_greedy.py "
        "-i {input} "
        "-o {output} "
        "-m {params.max_steps} "
        "-l {params.sample_size_landscapes} "
        "-s {params.sample_size_walks} "
        "-u {params.lethal} "
        "-r {wildcards.seed} "


        ph_distr=["%s/phenotype_distribution.txt" % config["ref_dir"]] + expand("bp_graph{{ref_bp}}/ranking{rank}/phenotype_distribution.txt", rank=config["rankings"]),
        ph_rob=["%s/phenotype_robustness.txt" % config["ref_dir"]] + expand("bp_graph{{ref_bp}}/ranking{rank}/phenotype_robustness.txt", rank=config["rankings"])
    output:
        "bp_graph{ref_bp}/ranking{rank}/analysis/phenotype_robustness_freq_vs_vienna.pdf"
    params:
        rank_label=["ViennaRNA"] + [config["ref_bp_rule"]]
    shell:
        "plot_robustness_phenotype_freq_w_ref.py "
        "-d {input.ph_distr} "
        "-r {input.ph_rob} "
        "-l {params.rank_label} "
        "-e True " 
        "-o {output} "

